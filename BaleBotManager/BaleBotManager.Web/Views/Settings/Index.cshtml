@model BaleBotManager.Web.Models.SettingsViewModel

@{
    ViewData["Title"] = "تنظیمات";
    ViewData["PageEyebrow"] = "تنظیمات";
    ViewData["PageTitle"] = "اتصال به بله";
    ViewData["PageSub"] = "توکن بات را وارد کنید تا داشبورد بتواند از طرف بات پیام ارسال کند.";
}

@if (Model.Success == true)
{
    <div class="alert alert-success">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
        توکن با موفقیت ذخیره شد.
    </div>
}
else if (Model.Success == false)
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 16h.01"/></svg>
        لطفاً یک توکن معتبر وارد کنید.
    </div>
}

<div class="settings-grid">
    <!-- Credential card -->
    <div class="credential-card">
        <div class="credential-head">
            <div>
                <div style="font-weight:800; font-size:15px;">مدرک اتصال بات</div>
                <div style="font-size:12px; color:var(--ink-soft); margin-top:2px;">از BotFather@بله دریافت می‌شود</div>
            </div>
            <div class="credential-seal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
        </div>

        <form asp-controller="Settings" asp-action="SaveToken" method="post">
            <div class="token-row" style="margin-bottom:6px;">
                <input asp-for="Token" type="password" class="input input-mono" placeholder="مثال: 123456:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxx" data-token-input />
                <button type="button" class="btn-icon" data-token-toggle aria-label="نمایش توکن">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
                <button type="button" class="btn-icon" data-token-copy aria-label="کپی توکن">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
            </div>
            <div class="field-hint" style="padding-inline-start:16px;">این توکن رمزگونه است؛ آن را در اختیار کسی قرار ندهید.</div>

            <div style="padding-inline-start:16px; margin-top:22px;">
                <button type="submit" class="btn btn-primary">ذخیره توکن</button>
            </div>
        </form>
    </div>

    <!-- Connection test panel -->
    <div class="connection-panel">
        <div style="font-weight:700; font-size:14px; margin-bottom:14px;">وضعیت اتصال</div>

        <div class="connection-state" data-connection-panel>
            <span class="pulse-ring" data-pulse-ring></span>
            <div>
                <div style="font-weight:700; font-size:13.5px;" data-connection-label>هنوز بررسی نشده</div>
                <div style="font-size:11.5px; color:rgba(246,241,228,.5);" data-bot-name>—</div>
            </div>
        </div>

        <button type="button" class="btn btn-ghost" style="width:100%; color:var(--cream); border-color:var(--border-soft-strong);"
                data-test-connection data-url="@Url.Action("TestConnection", "Settings")">
            بررسی اتصال با بله
        </button>

        <div class="meta-list">
            <div class="meta-row"><span class="k">آدرس پایه API</span><span class="v" style="direction:ltr;">tapi.bale.ai</span></div>
            <div class="meta-row"><span class="k">پروتکل</span><span class="v">HTTPS</span></div>
        </div>
    </div>
</div>

<div class="roadmap-strip">
    <span class="roadmap-pill"><span class="dot"></span> Webhook خودکار — به‌زودی</span>
    <span class="roadmap-pill"><span class="dot"></span> چند بات هم‌زمان — به‌زودی</span>
</div>
