@model BaleBotManager.Web.Models.SendMessageViewModel

@{
    ViewData["Title"] = "ارسال پیام";
    ViewData["PageEyebrow"] = "ارسال پیام";
    ViewData["PageTitle"] = "ارسال پیام مستقیم";
    ViewData["PageSub"] = "یک پیام متنی از طرف بات برای یک کاربر مشخص ارسال کنید.";
}

@if (Model.Success == true)
{
    <div class="alert alert-success">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
        پیام با موفقیت برای کاربر ارسال شد.
    </div>
}
else if (Model.Success == false)
{
    <div class="alert alert-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v5M12 16h.01"/></svg>
        ارسال پیام ناموفق بود. توکن یا Chat Id را بررسی کنید.
    </div>
}

<div class="composer-grid">
    <!-- Composer card -->
    <div class="card card-pad">
        <span class="recipient-chip">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            گیرنده پیام
        </span>

        <form asp-controller="Dashboard" asp-action="SendMessage" method="post">
            <div style="margin-bottom:18px;">
                <label class="field-label" asp-for="ChatId">شناسه چت (Chat Id)</label>
                <input asp-for="ChatId" class="input input-mono" placeholder="مثلاً 123456789" />
                <div class="field-hint">شناسه عددی گفتگوی کاربر در بله. از جدول کاربران قابل کپی است.</div>
            </div>

            <div style="margin-bottom:6px;">
                <label class="field-label" asp-for="Text">متن پیام</label>
                <textarea asp-for="Text" class="textarea" placeholder="پیام خود را اینجا بنویسید…" data-message-input></textarea>
            </div>
            <div class="char-counter" data-char-counter>0 / 4096</div>

            <div style="display:flex; gap:10px; margin-top:22px;">
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>
                    ارسال پیام
                </button>
                <button type="reset" class="btn btn-ghost">پاک کردن</button>
            </div>
        </form>
    </div>

    <!-- Live preview -->
    <div class="phone-frame">
        <div class="phone-header">
            <div class="avatar">ب</div>
            <div>
                <div class="who">پیش‌نمایش گفتگو</div>
                <div class="status">همان‌طور که کاربر می‌بیند</div>
            </div>
        </div>
        <div class="phone-body">
            <div class="bubble empty" data-preview-bubble>پیام شما اینجا نمایش داده می‌شود…</div>
            <div class="bubble-meta">هم‌اکنون · بات</div>
        </div>
    </div>
</div>

<div class="roadmap-strip">
    <span class="roadmap-pill"><span class="dot"></span> ارسال گروهی — به‌زودی</span>
    <span class="roadmap-pill"><span class="dot"></span> پیام‌های زمان‌بندی‌شده — به‌زودی</span>
    <span class="roadmap-pill"><span class="dot"></span> ارسال عکس و فایل — به‌زودی</span>
</div>
